# Single-domain deploy on Apache (Hostinger): static Next.js export + Laravel API
# on ONE domain. This file ships in the build (public/ -> out/), so copying the
# build into public_html always lays down the correct rules.
#
#   /api/*  and  /webhooks/*   -> Laravel front controller (index.php)
#   /_next/*                   -> real build assets (missing chunk = real 404)
#   any existing file/folder   -> served as-is (all static frontend pages)
#   everything else            -> the SPA shell (index.html)

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # API, webhooks + public business microsites -> Laravel (REQUEST_URI is
  # preserved, so routes still match)
  RewriteRule ^(api|webhooks|site)(/|$) index.php [L]

  # Next build assets: serve as-is; a missing hashed chunk must return a real
  # 404, never the HTML shell served as JS.
  RewriteRule ^_next/ - [L]

  # Any real file or directory (static pages, logos, favicon) -> serve as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise -> the app shell so client routes never hard-404
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Content-hashed build assets are immutable — cache for a year.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must always be fresh so it references chunk hashes that exist now.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

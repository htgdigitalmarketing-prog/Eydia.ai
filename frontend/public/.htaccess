# Static Next.js export on Hostinger (Apache).
# Serves real files/folders as-is and falls back to the SPA shell for client
# routes. Cache policy below prevents the "ChunkLoadError / stale HTML pointing
# at a build hash that no longer exists" class of bug after a redeploy.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never rewrite build assets to the SPA shell: a missing hashed chunk must
  # return a real 404 (not index.html served as JS, which corrupts the app).
  RewriteRule ^_next/ - [L]

  # Serve any existing file or directory as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise fall back to the app shell so client routes never 404
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Content-hashed build assets are immutable — safe to cache for a year.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must never be cached: the browser must always fetch fresh HTML so it
  # references the chunk hashes that actually exist on the server right now.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

{
    "name": "heltog/whatsapp-saas",
    "type": "project",
    "description": "Multi-tenant WhatsApp automation SaaS on the official Meta WhatsApp Cloud API.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/horizon": "^5.0",
        "laravel/reverb": "^1.0",
        "php-open-source-saver/jwt-auth": "^2.7",
        "spatie/laravel-permission": "^6.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "darkaonline/l5-swagger": "^9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": { "php-http/discovery": true },
        "platform": {
            "php": "8.2.12",
            "ext-pcntl": "8.2.12",
            "ext-posix": "8.2.12",
            "ext-sodium": "8.2.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

# ── Application ─────────────────────────────────────────────
APP_NAME="JayVisionX"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# ── Database ────────────────────────────────────────────────
# Local dev (quickest): SQLite — create the file first:
#   touch database/database.sqlite
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/backend/database/database.sqlite
#
# Production / MySQL:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jayvisionx
DB_USERNAME=root
DB_PASSWORD=

# ── Redis (cache / queues / Reverb / rate limiting) ─────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 'sync' runs jobs inline (fine for local). Use 'redis' or 'database' in prod.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── Auth ────────────────────────────────────────────────────
# Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_ALGO=HS256

# ── Meta WhatsApp Cloud API ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v23.0
META_CONFIG_ID=
# Production credential. Encrypted at rest per-WABA in DB; env is bootstrap only.
META_SYSTEM_USER_TOKEN=
# Set true in local/testing to use FakeWhatsAppProvider (no network calls).
META_USE_FAKE=true
# Comma-separated extra secrets/tokens to accept during a credential rotation.
META_APP_SECRETS=
META_VERIFY_TOKENS=
META_GRAPH_BASE=https://graph.facebook.com

WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Encryption for stored Meta tokens ───────────────────────
# Uses APP_KEY by default; set a dedicated key only if you rotate separately.
ENCRYPTION_KEY=

# ── AWS S3 (media) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=

# ── Payments ────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Use rzp_test_* keys in local/testing, rzp_live_* only in production.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Reverb (WebSockets) ─────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# ── CORS (frontend origins) ────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Super Admin (seeded by SuperAdminSeeder) ────────────────
# Set a strong password here BEFORE seeding in any shared/production env.
SUPER_ADMIN_NAME="JayVisionX Admin"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=password

# ── Google OAuth (login + Business Profile) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in the Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the backend bounces the browser back to after OAuth (the Next.js app).
FRONTEND_URL=http://localhost:3000

# Google Business Profile connect flow (dash_gbp). Needs the business.manage
# scope on a Google Cloud project approved for the Business Profile API.
GOOGLE_GBP_REDIRECT_URI=http://localhost:8000/api/v1/auth/gbp/callback
GOOGLE_GBP_SCOPES=https://www.googleapis.com/auth/business.manage
GOOGLE_GBP_RETURN_PATH=/gbp

# Google Lead Form import (source GOOGLE).
GOOGLE_LEADS_REDIRECT_URI=http://localhost:8000/api/v1/auth/google-leads/callback

# ── Meta Lead Ads (dash_leads, source META) ─────────────────
META_LEADS_REDIRECT_URI=http://localhost:8000/api/v1/auth/meta-leads/callback
META_LEADS_RETURN_PATH=/leads

# ── AI (assistant / chatbot / SEO suggestions) ──────────────
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Push notifications (mobile) ─────────────────────────────
FCM_SERVER_KEY=

# ── Mobile-OTP login via WhatsApp (authentication template) ─
OTP_WHATSAPP_TEMPLATE=
# Language MUST match the template exactly (e.g. en vs en_US).
OTP_WHATSAPP_LANG=en_US
OTP_WHATSAPP_TYPE=authentication
OTP_WHATSAPP_BUTTON_SUBTYPE=url
OTP_WHATSAPP_PHONE_NUMBER_ID=

# ── Mobile-OTP login via SMS (MSG91 fallback) ───────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=
